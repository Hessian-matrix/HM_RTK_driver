<launch>
    <arg name="rtk_port" default="/dev/ttyS0"/>       <!-- RTK NMEA输入的Port -->
    <arg name="rtk_baudrate" default="460800"/>         <!-- RTK NMEA输入的波特率 -->

    <arg name="ntrip_ip" default="203.107.45.154"/>     <!-- Ntrip Url -->
    <arg name="ntrip_port" default="8002"/>             <!-- Ntrip port, WGS84 -->
    <arg name="ntrip_user" default="qxshu0032164"/>    <!-- Ntrip 用户名、账号 -->
    <arg name="ntrip_passwd" default="1679484"/>        <!-- Ntrip 密码 -->
    <arg name="ntrip_mountpoint" default="AUTO"/>       <!-- Ntrip 挂载点 -->

    <arg name="pub_rtk_nmea_topic" default="/rtk_nmea"/>           <!-- 解析发布的NMEA的topic -->
    <arg name="pub_rtk_ex_pose_topic" default="/rtk_extrinsic"/>   <!-- 解析发布的rtk2camL 外参的topic -->

    <!-- 6DOF外参配置，RTK在左目坐标系（XYZ-右下前）下的外参，即T_camL<-RTK -->
    <!-- 平移参数 (单位: 米) -->
    <arg name="ex_rtk_slam_tx" default="-0.002"/>  
    <arg name="ex_rtk_slam_ty" default="-0.05"/>
    <arg name="ex_rtk_slam_tz" default="-0.24"/>
    
    <!-- 旋转参数 (四元数表示: x, y, z, w) -->
    <arg name="ex_rtk_slam_qx" default="0.0"/>
    <arg name="ex_rtk_slam_qy" default="0.0"/>
    <arg name="ex_rtk_slam_qz" default="0.0"/>
    <arg name="ex_rtk_slam_qw" default="1.0"/>


    <node name="HM_RTK" pkg="hm_rtk" type="rtk_driver_node" output="screen">
        <param name="ntrip_ip" type="string" value="$(arg ntrip_ip)"/>
        <param name="ntrip_port" type="string" value="$(arg ntrip_port)"/>
        <param name="ntrip_user" type="string" value="$(arg ntrip_user)"/>
        <param name="ntrip_passwd" type="string" value="$(arg ntrip_passwd)"/>
        <param name="ntrip_mountpoint" value="$(arg ntrip_mountpoint)"/>
        <param name="rtk_port" value="$(arg rtk_port)"/>
        <param name="rtk_baudrate" value="$(arg rtk_baudrate)"/>
        <param name="pub_rtk_nmea_topic" value="$(arg pub_rtk_nmea_topic)"/>
        <param name="pub_rtk_ex_pose_topic" value="$(arg pub_rtk_ex_pose_topic)"/>

        <!-- 6DOF外参参数 -->
        <param name="ex_rtk_slam_tx" type="double" value="$(arg ex_rtk_slam_tx)"/>
        <param name="ex_rtk_slam_ty" type="double" value="$(arg ex_rtk_slam_ty)"/>
        <param name="ex_rtk_slam_tz" type="double" value="$(arg ex_rtk_slam_tz)"/>
        <param name="ex_rtk_slam_qx" type="double" value="$(arg ex_rtk_slam_qx)"/>
        <param name="ex_rtk_slam_qy" type="double" value="$(arg ex_rtk_slam_qy)"/>
        <param name="ex_rtk_slam_qz" type="double" value="$(arg ex_rtk_slam_qz)"/>
        <param name="ex_rtk_slam_qw" type="double" value="$(arg ex_rtk_slam_qw)"/>
    </node>
</launch>